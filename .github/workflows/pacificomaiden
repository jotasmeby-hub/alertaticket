name: 🤘 Iron Maiden — Pacífico Medio × 2

on:
  schedule:
    - cron: "*/5 * * * *"

  workflow_dispatch: {}

jobs:
  check-pacifico-medio:
    name: Verificar 2 entradas Pacífico Medio
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: 📂 Restaurar estado previo
        uses: actions/cache/restore@v4
        with:
          path: estado_pm.json
          key: pm-estado-${{ github.run_id }}
          restore-keys: pm-estado-

      - name: 🐍 Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: 📦 Instalar dependencias
        run: |
          pip install playwright requests --break-system-packages 2>/dev/null || pip install playwright requests
          playwright install chromium --with-deps

      - name: 🔍 Chequear Pacífico Medio ×2
        env:
          TELEGRAM_TOKEN:   ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          python3 << 'PYEOF'
          import os, json, asyncio, requests
          from datetime import datetime, timezone, timedelta
          from playwright.async_api import async_playwright

          TELEGRAM_TOKEN   = os.environ.get("TELEGRAM_TOKEN", "")
          TELEGRAM_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", "")
          URL_EVENTO = "https://www.ticketmaster.cl/event/iron-maiden-run-for-your-lives-scl-2026-venta-general"
          FECHA      = "31/10/2026"

          def send_telegram(msg):
              if not TELEGRAM_TOKEN or not TELEGRAM_CHAT_ID:
                  print("  sin credenciales Telegram")
                  return
              try:
                  r = requests.post(
                      f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage",
                      json={"chat_id": TELEGRAM_CHAT_ID, "text": msg,
                            "parse_mode": "HTML", "disable_web_page_preview": True},
                      timeout=10)
                  r.raise_for_status()
                  print("  Telegram OK")
              except Exception as e:
                  print(f"  Telegram error: {e}")

          def cargar_estado():
              if os.path.exists("estado_pm.json"):
                  try:
                      with open("estado_pm.json") as f:
                          return json.load(f)
                  except Exception:
                      pass
              return {}

          def guardar_estado(data):
              with open("estado_pm.json", "w") as f:
                  json.dump(data, f)

          async def run():
              result = {"disponible": False, "dos": False, "detalle": ""}

              async with async_playwright() as pw:
                  browser = await pw.chromium.launch(
                      headless=True,
                      args=["--no-sandbox", "--disable-dev-shm-usage"])
                  ctx = await browser.new_context(
                      user_agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124.0.0.0 Safari/537.36",
                      locale="es-CL", timezone_id="America/Santiago",
                      viewport={"width": 1440, "height": 900})
                  page = await ctx.new_page()

                  try:
                      # PASO 1: Navegar
                      print("PASO 1: Navegando...")
                      try:
                          await page.goto(URL_EVENTO, wait_until="networkidle", timeout=30000)
                      except Exception:
                          await page.goto(URL_EVENTO, wait_until="domcontentloaded", timeout=30000)
                      await asyncio.sleep(5)
                      print("PASO 1: OK")

                      # PASO 2: Abrir dropdown de fecha
                      print("PASO 2: Abriendo dropdown de fecha...")
                      for sel in ["text=Selecciona la función", "[class*='dropdown']", "[class*='select']"]:
                          try:
                              el = page.locator(sel).first
                              if await el.is_visible(timeout=2000):
                                  await el.click()
                                  await asyncio.sleep(2)
                                  print(f"PASO 2: dropdown abierto con '{sel}'")
                                  break
                          except Exception:
                              continue

                      # PASO 3: Seleccionar la fecha
                      print(f"PASO 3: Seleccionando {FECHA}...")
                      clicked_date = False
                      for sel in [f"text={FECHA}", f"li:has-text('{FECHA}')", f"[class*='option']:has-text('{FECHA}')"]:
                          try:
                              el = page.locator(sel).first
                              if await el.is_visible(timeout=2000):
                                  await el.click()
                                  await asyncio.sleep(4)
                                  clicked_date = True
                                  print(f"PASO 3: fecha seleccionada con '{sel}'")
                                  break
                          except Exception:
                              continue
                      if not clicked_date:
                          try:
                              await page.get_by_text(FECHA, exact=False).first.click()
                              await asyncio.sleep(4)
                              clicked_date = True
                              print("PASO 3: fecha seleccionada (fallback)")
                          except Exception as e:
                              print(f"PASO 3: FALLO seleccionar fecha: {e}")

                      # PASO 4: Click en Comprar
                      print("PASO 4: Buscando boton Comprar...")
                      clicked_comprar = False
                      for sel in ["button:has-text('Comprar')", "a:has-text('Comprar')", "text=Comprar"]:
                          try:
                              el = page.locator(sel).first
                              if await el.is_visible(timeout=3000):
                                  await el.click()
                                  await asyncio.sleep(6)
                                  clicked_comprar = True
                                  print(f"PASO 4: click Comprar con '{sel}'")
                                  break
                          except Exception:
                              continue
                      if not clicked_comprar:
                          print("PASO 4: no encontre boton Comprar, continuando...")

                      await asyncio.sleep(2)

                      # PASO 5: Leer el body y buscar Pacifico Medio
                      print("PASO 5: Leyendo body...")
                      texto = await page.inner_text("body")
                      texto_lower = texto.lower()
                      print(f"PASO 5: body tiene {len(texto)} chars")

                      # Imprimir fragmento del body para debug
                      if "pacifico" in texto_lower or "medio" in texto_lower:
                          idx = texto_lower.find("pacifico")
                          if idx < 0:
                              idx = texto_lower.find("medio")
                          print(f"PASO 5: contexto: ...{texto[max(0,idx-30):idx+60]}...")
                      else:
                          print("PASO 5: no encontre 'pacifico' ni 'medio' en el body")

                      if "pacifico medio" not in texto_lower:
                          print("PASO 5: Pacifico Medio NO aparece")
                          result["disponible"] = False
                          result["detalle"] = "No aparece"
                          await browser.close()
                          return result

                      print("PASO 5: Pacifico Medio ENCONTRADO")
                      result["disponible"] = True

                      # PASO 6: Click en Pacifico Medio
                      print("PASO 6: Haciendo click en Pacifico Medio...")
                      clicked_pm = False
                      for sel in ["text=Pacifico Medio", "text=Pacífico Medio",
                                  "[class*='sector']:has-text('Pacifico Medio')",
                                  "td:has-text('Pacifico Medio')"]:
                          try:
                              el = page.locator(sel).first
                              if await el.is_visible(timeout=3000):
                                  await el.click()
                                  await asyncio.sleep(3)
                                  clicked_pm = True
                                  print(f"PASO 6: click con '{sel}'")
                                  break
                          except Exception:
                              continue
                      if not clicked_pm:
                          try:
                              await page.get_by_text("Pacifico Medio", exact=False).first.click()
                              await asyncio.sleep(3)
                              clicked_pm = True
                              print("PASO 6: click fallback")
                          except Exception as e:
                              print(f"PASO 6: FALLO click: {e}")

                      await asyncio.sleep(2)

                      # PASO 7: Click en "+"
                      print("PASO 7: Buscando boton +...")
                      clicked_plus = False
                      try:
                          btns = page.locator("button")
                          count = await btns.count()
                          print(f"PASO 7: {count} botones en pagina")
                          for i in range(count):
                              b = btns.nth(i)
                              txt = await b.inner_text()
                              if txt.strip() == "+":
                                  await b.click()
                                  await asyncio.sleep(2)
                                  clicked_plus = True
                                  print(f"PASO 7: click + (btn #{i})")
                                  break
                      except Exception as e:
                          print(f"PASO 7: error buscando +: {e}")

                      if not clicked_plus:
                          print("PASO 7: no encontre boton +")

                      await asyncio.sleep(2)

                      # PASO 8: Verificar popup de limite
                      print("PASO 8: Verificando popup limite...")
                      texto_post = await page.inner_text("body")
                      limite_msgs = ["maximo disponible", "limite de cantidad",
                                     "has seleccionado el maximo", "no hay mas entradas"]
                      if any(m in texto_post.lower() for m in limite_msgs):
                          print("PASO 8: popup limite detectado -> solo 1 entrada")
                          result["dos"] = False
                          result["detalle"] = "Solo 1 disponible"
                      elif clicked_plus:
                          print("PASO 8: sin popup -> 2 entradas disponibles!")
                          result["dos"] = True
                          result["detalle"] = "2 entradas juntas"
                      else:
                          print("PASO 8: no pude verificar (no hice click en +)")
                          result["dos"] = False
                          result["detalle"] = "No verificado"

                  except Exception as e:
                      print(f"ERROR GENERAL: {e}")
                      result["detalle"] = f"Error: {e}"

                  await browser.close()
              return result

          # ══════════════════
          ahora_utc = datetime.now(timezone.utc)
          hora_scl  = ahora_utc - timedelta(hours=4)

          print("=" * 55)
          print(f"  Iron Maiden Pacifico Medio x2 — {hora_scl.strftime('%H:%M')} Santiago")
          print("=" * 55)

          result = asyncio.run(run())
          print(f"\n  Resultado: {result}")

          if result["disponible"] and result["dos"]:
              send_telegram(
                  f"ALERTA: Pacifico Medio x2 DISPONIBLES!\n\n"
                  f"Hay 2 entradas juntas en Pacifico Medio\n\n"
                  f"COMPRA AHORA:\n{URL_EVENTO}\n\n"
                  f"{hora_scl.strftime('%H:%M')} Santiago"
              )
              print("  ALERTA ENVIADA: 2 entradas disponibles!")
          else:
              estado_txt = "solo 1" if result["disponible"] else "no disponible"
              print(f"  Sin alerta ({estado_txt}) — esperando 2 juntas")

          guardar_estado({
              "disponible": result["disponible"],
              "dos":        result["dos"],
              "detalle":    result["detalle"],
              "ultimo_check": ahora_utc.isoformat(),
          })
          print("=" * 55)
          PYEOF

      - name: 💾 Guardar estado
        uses: actions/cache/save@v4
        if: always()
        with:
          path: estado_pm.json
          key: pm-estado-${{ github.run_id }}
